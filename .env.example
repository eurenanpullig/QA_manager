# =============================================================================
# GESTOR DE TESTES CORPORATIVO (SELF-HOSTED) - ENVIRONMENT CONFIGURATION
# =============================================================================

# Global Environment
NODE_ENV=development

# Database Configuration (PostgreSQL 15+)
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=gestor_testes
POSTGRES_USER=gt_admin
POSTGRES_PASSWORD=gt_secure_password
DATABASE_URL=postgres://gt_admin:gt_secure_password@postgres-db:5432/gestor_testes

# Microservices Network Ports
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=5001
PROJECT_SERVICE_PORT=5002
TEST_EXECUTION_SERVICE_PORT=5003
STORAGE_SERVICE_PORT=5004
FRONTEND_PORT=3000

# Internal Microservices Discovery URLs (Gateway Routing)
AUTH_SERVICE_URL=http://auth-service:5001
PROJECT_SERVICE_URL=http://project-service:5002
TEST_EXECUTION_SERVICE_URL=http://test-execution-service:5003
STORAGE_SERVICE_URL=http://storage-service:5004

# Security, JWT & Cookie Settings (auth-service & api-gateway)
JWT_SECRET=super_jwt_secret_token_change_in_production
JWT_REFRESH_SECRET=super_jwt_refresh_secret_token_change_in_production
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=1h
CSRF_SECRET=super_csrf_secret_token_change_in_production
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
CORS_ORIGIN=http://localhost:3000

# Storage & Upload Quotas (storage-service)
STORAGE_VOLUME_PATH=/var/app/uploads
MAX_IMAGE_SIZE_BYTES=31457280
MAX_VIDEO_SIZE_BYTES=209715200
MAX_LOG_SIZE_BYTES=10485760

# Frontend Public Environment Variables
VITE_API_GATEWAY_URL=http://localhost:8000/api/v1
